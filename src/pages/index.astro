    const categorySelect =
      document.getElementById('category') as HTMLSelectElement | null;
    const generateButton =
      document.getElementById('generate') as HTMLButtonElement | null;
    const moreButton =
      document.getElementById('more') as HTMLButtonElement | null;
    const results = document.getElementById('results') as HTMLElement | null;
    const feedback = document.getElementById('feedback') as HTMLElement | null;

    let lastCategory = 'all';
    let shownCaptions = new Set<string>();
    let currentBatch: string[] = [];
    const batchSize = 5;

    function shuffle<T>(items: T[]): T[] {
      const shuffled = [...items];

      for (let i = shuffled.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
      }

      return shuffled;
    }

    function getPool(category: string): string[] {
      if (category === 'all') {
        return Object.values(captions).flat();
      }

      return captions[category] ?? [];
    }

    function pickBatch(category: string, count: number): string[] {
      const pool = getPool(category);
      const available = pool.filter(
        (caption) => !shownCaptions.has(caption)
      );

      const batch = shuffle(available).slice(0, count);

      batch.forEach((caption) => shownCaptions.add(caption));

      return batch;
    }

    function updateMoreButton(): void {
      if (!moreButton) return;

      const remaining = getPool(lastCategory).some(
        (caption) => !shownCaptions.has(caption)
      );

      moreButton.hidden = !remaining || currentBatch.length === 0;
    }

    function showEmptyState(message: string): void {
      if (!results) return;

      const wrapper = document.createElement('div');
      wrapper.className = 'empty-state';

      const icon = document.createElement('span');
      icon.className = 'empty-icon';
      icon.setAttribute('aria-hidden', 'true');
      icon.textContent = '✳';

      const title = document.createElement('p');
      title.className = 'empty-title';
      title.textContent = message;

      const description = document.createElement('p');
      description.className = 'empty-copy';
      description.textContent = 'Try another category to find more captions.';

      wrapper.append(icon, title, description);
      results.replaceChildren(wrapper);
    }

    function createCaptionCard(caption: string): HTMLElement {
      const card = document.createElement('article');
      card.className = 'caption-card';

      const text = document.createElement('p');
      text.className = 'caption-text';
      text.textContent = caption;

      const copy = document.createElement('button');
      copy.className = 'copy-button';
      copy.type = 'button';
      copy.textContent = 'Copy';
      copy.setAttribute('aria-label', `Copy caption: ${caption}`);

      copy.addEventListener('click', async () => {
        if (!feedback) return;

        try {
          if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(caption);
          } else {
            const temporary = document.createElement('textarea');
            temporary.value = caption;
            temporary.setAttribute('readonly', '');
            temporary.style.position = 'fixed';
            temporary.style.opacity = '0';
            document.body.appendChild(temporary);
            temporary.select();

            const copied = document.execCommand('copy');
            temporary.remove();

            if (!copied) {
              throw new Error('Clipboard copy failed');
            }
          }

          copy.textContent = 'Copied ✓';
          feedback.textContent = 'Caption copied to clipboard.';

          window.setTimeout(() => {
            copy.textContent = 'Copy';
          }, 1400);
        } catch {
          feedback.textContent =
            'Copy was blocked. Select the caption text and copy it manually.';
        }
      });

      card.append(text, copy);

      return card;
    }

    function renderBatch(append: boolean): void {
      if (!results) return;

      if (!append) {
        currentBatch = [];
        results.replaceChildren();
      }

      const batch = pickBatch(lastCategory, batchSize);

      if (!batch.length) {
        if (!append || currentBatch.length === 0) {
          showEmptyState(
            'You have seen all the captions in this category.'
          );
        }

        updateMoreButton();

        if (feedback) {
          feedback.textContent = 'Choose another category for fresh captions.';
        }

        return;
      }

      currentBatch = [...currentBatch, ...batch];

      const fragment = document.createDocumentFragment();

      batch.forEach((caption) => {
        fragment.appendChild(createCaptionCard(caption));
      });

      results.appendChild(fragment);
      updateMoreButton();

      if (feedback) {
        feedback.textContent = `${currentBatch.length} captions shown.`;
      }
    }

    generateButton?.addEventListener('click', () => {
      lastCategory = categorySelect?.value || 'all';
      shownCaptions = new Set<string>();
      currentBatch = [];

      if (feedback) feedback.textContent = '';

      renderBatch(false);
    });

    moreButton?.addEventListener('click', () => {
      renderBatch(true);
    });

    categorySelect?.addEventListener('change', () => {
      if (feedback) feedback.textContent = '';
    });
  </script>

