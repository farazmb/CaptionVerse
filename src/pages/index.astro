
---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'CaptionVerse — Free Caption Generator';
const description =
  'Find natural Instagram captions for everyday moments, love, selfies, travel, cars, friendship, and more.';
---

<BaseLayout title={title} description={description} canonicalPath="/">
  <div class="site-shell">
    <header class="topbar">
      <a class="brand" href="/" aria-label="CaptionVerse home">
        <span class="brand-mark">c.</span>
        <span>CaptionVerse</span>
      </a>
      <a class="top-link" href="#generator">
        Create a caption <span aria-hidden="true">↗</span>
      </a>
    </header>

    <main>
      <section class="hero">
        <div class="hero-label">
          <span class="status-dot"></span>
          YOUR NEXT CAPTION STARTS HERE
        </div>

        <h1>A photo says a lot.<br /><span>Find the right words.</span></h1>

        <p class="hero-copy">
          From random camera-roll moments to the pictures you actually plan
          to post. Find a caption that feels like you.
        </p>

        <a class="hero-cta" href="#generator">
          Find my caption <span aria-hidden="true">↓</span>
        </a>

        <div class="hero-meta">
          <span><span aria-hidden="true">✳</span> Free to use</span>
          <span><span aria-hidden="true">✳</span> No sign-up</span>
          <span><span aria-hidden="true">✳</span> Copy in one click</span>
        </div>
      </section>

      <section id="generator" class="generator-section" aria-labelledby="tool-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">THE CAPTION STUDIO</p>
            <h2 id="tool-title">What's the post about?</h2>
            <p class="section-copy">Pick a category. We'll handle the words.</p>
          </div>
          <span class="studio-icon" aria-hidden="true">✳</span>
        </div>

        <div class="tool">
          <div class="form-step">
            <span class="step-number" aria-hidden="true">01</span>

            <div class="step-content">
              <label for="category">Choose your vibe</label>
              <p class="field-hint">What kind of photo are you posting?</p>

              <select id="category" name="category">
                <option value="all">Surprise me — all categories</option>
                <option value="everyday">Everyday life</option>
                <option value="selfie">Selfies &amp; photos</option>
                <option value="love">Love &amp; relationships</option>
                <option value="friendship">Friendship</option>
                <option value="attitude">Attitude &amp; confidence</option>
                <option value="funny">Funny &amp; relatable</option>
                <option value="sad">Sad &amp; introspective</option>
                <option value="heartbreak">Heartbreak &amp; moving on</option>
                <option value="travel">Travel &amp; adventure</option>
                <option value="cars">Cars</option>
                <option value="fitness">Gym &amp; fitness</option>
                <option value="food">Food &amp; coffee</option>
                <option value="nature">Nature &amp; outdoors</option>
                <option value="birthday">Birthday</option>
                <option value="work">Work &amp; ambition</option>
                <option value="night">Night &amp; late thoughts</option>
                <option value="aesthetic">Minimal &amp; aesthetic</option>
                <option value="celebration">Celebrations</option>
              </select>

              <button class="primary" id="generate" type="button">
                Generate captions <span aria-hidden="true">↗</span>
              </button>
            </div>
          </div>

          <div class="results-heading">
            <div class="results-title-group">
              <span class="step-number" aria-hidden="true">02</span>
              <div>
                <h3>Your captions</h3>
                <p>Pick the one that feels right and copy it.</p>
              </div>
            </div>
            <span class="results-badge">YOUR PICKS</span>
          </div>

          <div id="results" class="results" aria-live="polite" aria-busy="false">
            <div class="empty-state">
              <span class="empty-icon" aria-hidden="true">✳</span>
              <p class="empty-title">Your next caption is waiting.</p>
              <p class="empty-copy">
                Choose a vibe above and tap Generate captions to get started.
              </p>
            </div>
          </div>

          <button class="text-button" id="more" type="button" hidden>
            Show me more <span aria-hidden="true">↻</span>
          </button>

          <p class="privacy-note">Free to use · No account needed · No repeated captions in a batch</p>
          <p id="feedback" role="status" aria-live="polite"></p>
        </div>
      </section>

      <section class="closing">
        <span class="closing-mark" aria-hidden="true">✳</span>
        <h2>Less overthinking.<br /><span>More posting.</span></h2>
        <p>
          Your moment, your mood, your words. Find something that fits
          and get back to your day.
        </p>
        <a href="#generator" class="closing-link">
          Find your next caption <span aria-hidden="true">↑</span>
        </a>
      </section>
    </main>

    <footer class="footer">
      <a class="brand footer-brand" href="/" aria-label="CaptionVerse home">
        <span class="brand-mark">c.</span>
        <span>CaptionVerse</span>
      </a>
      <p>Find the words. Keep it you.</p>
      <a href="#generator" class="footer-link">Back to generator ↑</a>
    </footer>
  </div>

